{document;
#url{https://tmark.waus.app/examples/edge_cases.tmark}
#title{Other edge cases}
{h;#s{4}Reserved characters}
{p;Reserved characters: \# \{ \} \\ should be escaped.}
{h;#s{4}Semicolon and line break}
{p;A semicolon (;) stays literal; line breaks
stay in the text.}
{h;#s{4}Line break in a table cell}
{table;
{{Row 1}{First line}}
{{Row 2}{First line
Second line}}
{{Row 3}{Last line}}
}
{h;#s{4}Special characters in a URL}
{p;{a;#href{https://example.com/search?q=\{tmark\}\#top}URL with braces and hash}}
{h;#s{4}Raw markup in a code block}
{pre;
#language{tmark}
\{document;
\#url\{u\}
\#title\{t\}
\{p;raw-ish \# text\}
\}
}
{h;#s{4}Combined formatting}
{p;{b;{i;This text is bold and italic.}}}
{p;{s;{b;This text is struck through and bold.}}}
{p;{s;{m;{i;This text is struck through, highlighted, and italic.}}}}
{p;{u;{b;This text is underlined and bold.}}}
{p;{m;{u;This text is highlighted and underlined.}}}
{p;{b;{i;{u;This text is bold, italic, and underlined.}}}}
{p;{spoiler;{b;This spoiler contains bold text.}}}
{p;{a;#href{https://example.com}{i;{u;This link is italic and underlined.}}}}
{p;A sentence with {b;{m;bold highlighting}} and {i;{s;italic strikethrough}}.}
{p;Bold inline code: {b;{code;const value = 1}}}
{h;#s{4}Long unbroken text}
{p;long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-long-word-{code;xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx}}
{h;#s{4}Unknown block}
{p;Paragraph before an unknown block.}
{colorpicker;#from{ad34f1}#to{000000}My palette}
{p;Paragraph after an unknown block.}
{h;#s{4}Small image}
{img;#caption{C language logo}https://tmark.waus.app/static/c-logo.png}
