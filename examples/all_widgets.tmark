{document;
#url{https://tmark.waus.app/examples/all_widgets.tmark}
#title{All widgets}
{h;#s{3}Text and formatting}
{h;#s{4}Inline formatting}
{p;Plain text, {b;bold text}, {i;italic text}, {m;marked text}, {u;underlined text}, {s;struck text}, {spoiler;spoiler text}, {sub;sub} and {sup;sup}, {code;inline code}, {math;E=mc^2}, {datetime;#timezone{UTC}1767225600}, {a;#href{https://example.com}external link}, and an icon: {icon;#alt{C language logo}https://tmark.waus.app/static/c-logo.png}.}
{p;A paragraph can contain line breaks.
This line is still in the same paragraph.}
{pre;
#language{go}
package main

func main() \{
	println("Hello, tmark")
\}
}
{math-block;
\\int_0^1 x^2 dx = \\frac\{1\}\{3\}
}
{anchor;section-anchor}
{as;#credit{Example author}A pull quote highlights a short passage of text.}
{q;
#credit{Example author}
{h;#s{4}This is a blockquote}
{p;It can contain paragraphs, images, and other blocks.}
}
{list;
{{p;A plain bullet}}
{{p;Another bullet}}
}
{list;
{#order{1}{p;A numbered item}}
{#type{A}#order{2}{p;An item labeled with a letter}}
}
{list;
{#type{checkbox}#checked{t}{p;A completed task}}
}
{hr;}
{map;#lat{52.520008}#lon{13.404954}#zoom{12}#caption{Berlin}}
{img;#caption{#credit{Unknown author}Mountain panorama}https://tmark.waus.app/static/mountains-wide.webp}
{collage;
#caption{Image collage}
{img;https://tmark.waus.app/static/mountains-lake.webp}
{img;https://tmark.waus.app/static/mountains-portrait.webp}
{img;https://tmark.waus.app/static/mountains-summit.webp}
}
{slideshow;
#caption{Image and video slideshow}
{img;https://tmark.waus.app/static/mountains-rockies.webp}
{img;https://tmark.waus.app/static/mountains-valley.webp}
{video;https://tmark.waus.app/static/Big_Buck_Bunny_720_10s_1MB.mp4}
}
{table;
#caption{Table}
#bordered{t}
#striped{t}
{{#header{t}}{#header{t}#align{center}Tmark}{#header{t}#align{center}Markdown}{#header{t}#align{center}HTML}{#header{t}#align{center}LaTeX}}
{{#header{t}Strict}{#align{center}***}{#align{center}*}{#align{center}**}{#align{center}***}}
{{#header{t}Batteries}{#align{center}***}{#align{center}**}{#align{center}****}{#align{center}****}}
{{#header{t}Extensibility}{#align{center}***}{#align{center}*}{#align{center}**}{#align{center}****}}
{{#header{t}Complexity}{#align{center}*}{#align{center}***}{#align{center}***}{#align{center}*****}}
}
{details;#summary{More details}{p;Details can also contain several paragraphs or other blocks.}}
{audio;#caption{Audio}https://tmark.waus.app/static/mountain-ambient.mp3}
}
