{h;#s{3}Numbered and lettered items}
{list;
{#order{10}{p;Starts at ten}}
{#order{11}{p;Continues at eleven}}
}
{list;
{#type{a}#order{1}{p;Lowercase letters}}
{#type{a}#order{2}{p;The next lowercase letter}}
{#type{A}#order{3}{p;Uppercase letters}}
{#type{A}#order{27}{p;Letters continue past Z}}
}
{list;
{#type{i}#order{4}{p;Lowercase Roman numerals}}
{#type{I}#order{9}{p;Uppercase Roman numerals}}
{#type{1}#order{12}{p;Explicit decimal numbering}}
}
{h;#s{3}Tasks}
{list;
{#type{checkbox}#checked{f}{p;An unfinished task}}
{#type{checkbox}#checked{t}{p;A finished task}}
}
}
